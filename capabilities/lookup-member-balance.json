  "recoverables": [
    {
      "id": "session-expired",
      "description": "Session timed out mid-flow; restart from the beginning (login steps re-authenticate).",
      "detect": { "kind": "text", "value": "Session expired" },
      "strategy": "restart",
      "maxAttempts": 1
    }
