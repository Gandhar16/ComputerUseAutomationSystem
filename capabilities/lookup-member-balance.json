    },
    {
      "index": 6,
      "verb": "click",
      "description": "Click 'View' link on the matching search result row",
      "target": {
        "description": "'View' (link)",
        "candidates": [
          { "strategy": "role", "value": "link::View", "note": "Accessible role+name; unique because search returns a single member." },
          { "strategy": "text", "value": "View", "note": "Exact visible text." }
