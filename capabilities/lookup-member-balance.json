{
  "schemaVersion": "1.0",
  "capability": {
    "id": "lookup-member-balance",
    "name": "Look up member savings balance",
    "version": 1,
    "description": "Look up a member by member number and read their current savings balance.",
    "appId": "legacycu",
    "createdAt": "2026-08-13T00:00:00.000Z",
    "createdFromRun": "fixture-hand-authored (to be regenerated by a real discovery run)",
