  "expectedOutcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "The searched member number does not exist. Legitimate business result, not a failure.",
      "detect": { "kind": "text", "value": "No member found" }
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The operator role is not allowed to perform this action.",
      "detect": { "kind": "text", "value": "Access denied" }
