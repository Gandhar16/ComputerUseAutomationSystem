        "description": "'Member Search' (link)",
        "candidates": [
          { "strategy": "role", "value": "link::Member Search", "note": "Accessible role+name." },
          { "strategy": "text", "value": "Member Search", "note": "Exact visible text." }
        ]
      },
      "sensitive": false,
      "risky": false,
      "checkpoint": {
        "description": "Landed on Member Search",
        "predicates": [{ "kind": "urlPath", "value": "/members" }]
      }
    },
    {
      "index": 4,
      "verb": "type",
      "description": "Type member number into 'Member Number:' field",
      "target": {
        "description": "'Member Number:' (textbox)",
        "candidates": [
          { "strategy": "tdlabel", "value": "Member Number:", "note": "Legacy table-form label anchor." },
          { "strategy": "attr", "value": "[name=\"q\"]", "note": "Form field name." },
          { "strategy": "attr", "value": "#ctl00_cph_txtMbr", "note": "Framework-generated id; low trust." }
        ]
      },
      "value": "{{memberId}}",
      "sensitive": false,
      "risky": false
    },
    {
      "index": 5,
      "verb": "click",
      "description": "Click 'Search' button",
      "target": {
        "description": "'Search' (button)",
        "candidates": [
          { "strategy": "role", "value": "button::Search", "note": "Accessible role+name." },
          { "strategy": "attr", "value": "#ctl00_cph_btnGo", "note": "Framework-generated id; low trust." }
        ]
      },
      "sensitive": false,
      "risky": false,
      "checkpoint": {
        "description": "Search executed; results screen shown",
        "predicates": [{ "kind": "urlPath", "value": "/members/search" }]
