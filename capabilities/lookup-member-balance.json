          {
            "strategy": "css",
            "value": "tr:has(td:text-is(\"Savings Balance\")) td:nth-of-type(2)",
            "note": "Anchored to the row label text — survives id churn."
          }
        ]
      }
    }
  ],
  "steps": [
    {
      "index": 0,
      "verb": "type",
      "description": "Type into 'Operator ID:' field (credential)",
      "target": {
        "description": "'Operator ID:' (textbox)",
        "candidates": [
          { "strategy": "tdlabel", "value": "Operator ID:", "note": "Legacy table-form pattern: control anchored to its row's label-cell text." },
          { "strategy": "attr", "value": "[name=\"txtUser\"]", "note": "Form field name — the POST contract; rarely renamed." },
          { "strategy": "attr", "value": "#ctl00_main_txt1", "note": "Framework-generated id; low trust." }
        ]
      },
      "value": "{{credential:username}}",
      "sensitive": true,
      "risky": false
    },
    {
      "index": 1,
      "verb": "type",
      "description": "Type into 'Password:' field (sensitive)",
      "target": {
        "description": "'Password:' (textbox)",
        "candidates": [
          { "strategy": "tdlabel", "value": "Password:", "note": "Legacy table-form label anchor." },
          { "strategy": "attr", "value": "[name=\"txtPass\"]", "note": "Form field name." },
          { "strategy": "attr", "value": "#ctl00_main_txt2", "note": "Framework-generated id; low trust." }
        ]
      },
      "value": "{{credential:password}}",
      "sensitive": true,
      "risky": false
    },
    {
      "index": 2,
      "verb": "click",
      "description": "Click 'Sign On' button",
      "target": {
        "description": "'Sign On' (button)",
        "candidates": [
          { "strategy": "role", "value": "button::Sign On", "note": "Accessible role+name — most stable across reskins." },
          { "strategy": "attr", "value": "#ctl00_main_btn1", "note": "Framework-generated id; low trust." }
        ]
      },
      "sensitive": false,
      "risky": false,
      "checkpoint": {
        "description": "Signed on; landed on the Teller Desk dashboard",
