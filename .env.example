# NVIDIA API key for the discovery run (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-...
# Model to use for discovery (any NVIDIA-hosted model with tool calling)
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Credentials the automation uses to log in to the target app.
# Referenced by artifacts as {{credential:username}} / {{credential:password}} —
# never persisted into artifacts or logs.
TARGET_USERNAME=demo
TARGET_PASSWORD=demo123
